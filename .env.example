# App and Server Configuration
PORT=3000
APP_URL="MY_APP_URL"
APP_TIMEZONE="Asia/Kolkata"
APP_CONTACT="contact@smartbustracker.local"

# External Routing and Map Services
OSRM_URL="https://router.project-osrm.org"

# Gemini AI (Optional - Route insights & corridor summaries)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# GTFS Static and Realtime Feeds (Optional)
# Path to directory containing unzipped GTFS .txt files (routes, stops, trips, stop_times, calendar, calendar_dates, agency)
GTFS_DIR=""
GTFS_STOP_RADIUS_KM=3
# GTFS-Realtime Protocol Buffer feed URL (VehiclePositions)
GTFS_RT_VEHICLE_POSITIONS_URL=""
GTFS_RT_AUTH_HEADER=""

# Provider Fallback (defaults to true; if false, returns empty results when GTFS has no matches)
SIMULATED_FALLBACK="true"
